# Apache sunucusu için yönlendirme, güvenlik başlıkları ve hata sayfası kuralları.\nOptions -Indexes
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
  Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=IS_ADMIN
</IfModule>
<Files "admin.html">
  <IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </IfModule>
</Files>
